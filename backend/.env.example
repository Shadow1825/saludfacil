# Copiar como `.env` dentro de backend/ para ejecución local
# Cuando se ejecuta con Docker Compose, la raíz del proyecto ya inyecta estas variables.
DATABASE_URL=postgresql+psycopg://saludfacil:saludfacil_dev_password@localhost:5432/saludfacil
SECRET_KEY=cambiar-este-secreto-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173