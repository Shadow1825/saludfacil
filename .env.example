# ============================================================
# SaludFácil — Variables de entorno (ejemplo)
# Copiar como `.env` para entorno local.
# NUNCA subir datos reales al repositorio.
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=saludfacil
POSTGRES_USER=saludfacil
POSTGRES_PASSWORD=saludfacil_dev_password
POSTGRES_PORT=5432

# --- Backend ---
# URL de conexión usada por el backend
DATABASE_URL=postgresql+psycopg://saludfacil:saludfacil_dev_password@postgres:5432/saludfacil
# Secreto JWT (FASE 2). Generar uno seguro localmente.
SECRET_KEY=cambiar-este-secreto-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Entorno: development | production
ENVIRONMENT=development
# CORS: orígenes permitidos (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Frontend ---
VITE_API_URL=http://localhost:8000